{
  "manifest_version": 3,
  "name": "FocusFlow: Real Context Engine",
  "version": "8.0.0",
  "description": "Spatial dwell tracking, auto-scroll recovery, YouTube focus shield, and live cloud telemetry bridge.",
  "permissions": ["storage", "activeTab", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": [
        "https://*.vercel.app/*",
        "http://localhost/*",
        "<all_urls>"
      ],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ],
  "action": {
    "default_popup": "dashboard.html"
  }
}
