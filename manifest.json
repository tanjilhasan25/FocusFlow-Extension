{
  "manifest_version": 3,
  "name": "FocusFlow: Multi-User Context & Shield Engine",
  "version": "3.0.0",
  "description": "Spatial dwell tracking, viewport center fallback, YouTube distraction shield, and multi-user room synchronization.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "dashboard.html",
    "default_title": "FocusFlow Dashboard"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["style.css"],
      "js": ["content.js"]
    }
  ]
}
